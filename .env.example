# --- Discord ---
DISCORD_TOKEN=               # Developer Portal → Bot → Reset Token
MAIN_GUILD_ID=               # the server being protected
MIRROR_GUILD_ID=             # the sister server that holds the message mirror
PREFIX=frst

# --- Supabase Postgres (session pooler, port 5432) ---
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# --- Dump API (Supabase Edge Function `frostbot-dump`) ---
# Not read by the bot; it's pushed to the function with `pnpm deploy:dump`.
API_TOKEN=                   # openssl rand -hex 32 (also = FROSTBOT_TOKEN for the pull script)

# Hosted bot (Bot-Hosting panel) for `npm run ship`: panel → Account → API Credentials.
# Server id = the short id in the server's panel URL. Leave empty to restart by hand.
PANEL_URL=https://control.bot-hosting.net
PANEL_SERVER_ID=
PANEL_API_KEY=
